# ==============================================================================
# ScamShield — Environment Configuration Template
# ==============================================================================

# Server Configuration
HOST=127.0.0.1
PORT=8000
ENVIRONMENT=development
DEBUG=True

# Google Gemini AI Integration
# Acquire API key from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=12.0

# Risk Scoring Policy Thresholds (Configurable)
RISK_LOW_THRESHOLD=29
RISK_MODERATE_THRESHOLD=59
RISK_HIGH_THRESHOLD=84

# Rate Limiting (Requests per minute per IP)
RATE_LIMIT_PER_MINUTE=60

# Storage & Persistence
# Options: "sqlite", "memory", "firestore"
STORAGE_TYPE=sqlite
SQLITE_DB_PATH=scamshield.db

# Optional Firebase / Google Cloud Firestore Configuration
# (If omitted, ScamShield defaults to local isolated SQLite storage)
FIREBASE_PROJECT_ID=
FIREBASE_CREDENTIALS_PATH=
